{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Launch Command Center",
            "type": "shell",
            "command": "./launcher.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}